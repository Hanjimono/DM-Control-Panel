{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DM Control Panel",
  "version": "0.1.0",
  "identifier": "com.hanjimono.dmcontrolpanel",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DM Control Panel",
        "width": 960,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "config.toml"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
